// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users ─────────────────────────────────────────────────────────────────────
// Tabel pemilik bot (tenant). Setiap user memiliki bot instance, config, dan data tersendiri.

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.Text
  name         String   @db.VarChar(100)
  plan         UserPlan @default(FREE)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relasi ke tabel lainnya
  botConfigs   BotConfig[]
  credentials  BotCredential[]
  products     Product[]
  orders       Order[]

  @@map("users")
}

enum UserPlan {
  FREE
  STARTER
  PRO
}

// ── Bot Config ────────────────────────────────────────────────────────────────
// Menyimpan konfigurasi umum bot yang tidak sensitif.
// Setiap user memiliki BotConfig sendiri (user_id FK).

model BotConfig {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  mode             BotMode  @default(BUTTON)
  // Midtrans
  midtransIsProduction Boolean @default(false) @map("midtrans_is_production")
  // Meta
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, isActive])
  @@map("bot_config")
}

enum BotMode {
  AI
  BUTTON
}

// ── Bot Credentials ───────────────────────────────────────────────────────────
// Menyimpan credentials sensitif — nilai disimpan TERENKRIPSI (AES-256-GCM).
// Setiap user memiliki credentials sendiri (user_id FK).

model BotCredential {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  key       String   @db.VarChar(100)
  value     String?  @db.Text     // AES-256-GCM encrypted: "iv:authTag:ciphertext" (nullable)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("bot_credentials")
}

// ── Products ──────────────────────────────────────────────────────────────────

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String   @db.VarChar(100)
  description String   @db.Text
  price       Int
  emoji       String   @db.VarChar(10) @default("🛍️")
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("products")
}

// ── Orders ────────────────────────────────────────────────────────────────────

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  orderId         String      @map("order_id") @db.VarChar(30)
  telegramId      BigInt      @map("telegram_id")
  username        String?     @db.VarChar(100)
  firstName       String?     @map("first_name") @db.VarChar(100)
  totalPrice      Int         @map("total_price")
  status          OrderStatus @default(PENDING)
  paymentUrl      String?     @map("payment_url") @db.Text
  qrString        String?     @map("qr_string") @db.Text
  midtransOrderId String?     @map("midtrans_order_id") @db.VarChar(50)
  paidAt          DateTime?   @map("paid_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([userId, orderId])
  @@unique([userId, midtransOrderId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Int     @map("unit_price")

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
  PAYMENT_PENDING
  PAYMENT_FAILED
}
