// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users ─────────────────────────────────────────────────────────────────────
// Tabel pemilik bot (tenant). Setiap user memiliki bot instance, config, dan data tersendiri.

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.Text
  name         String   @db.VarChar(100)
  plan         UserPlan @default(FREE)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relasi ke tabel lainnya
  botConfigs   BotConfig[]
  credentials  BotCredential[]
  products     Product[]
  orders       Order[]
  tickets      Ticket[]
  labels       Label[]
  comments     TicketComment[]
  activities   TicketActivity[]
  customers    Customer[]

  @@map("users")
}

enum UserPlan {
  FREE
  STARTER
  PRO
}

// ── Bot Config ────────────────────────────────────────────────────────────────
// Menyimpan konfigurasi umum bot yang tidak sensitif.
// Setiap user memiliki BotConfig sendiri (user_id FK).

model BotConfig {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  mode             BotMode  @default(BUTTON)
  // Midtrans
  midtransIsProduction Boolean @default(false) @map("midtrans_is_production")
  // Meta
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, isActive])
  @@map("bot_config")
}

enum BotMode {
  AI
  BUTTON
}

// ── Bot Credentials ───────────────────────────────────────────────────────────
// Menyimpan credentials sensitif — nilai disimpan TERENKRIPSI (AES-256-GCM).
// Setiap user memiliki credentials sendiri (user_id FK).

model BotCredential {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  key       String   @db.VarChar(100)
  value     String?  @db.Text     // AES-256-GCM encrypted: "iv:authTag:ciphertext" (nullable)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("bot_credentials")
}

// ── Products ──────────────────────────────────────────────────────────────────

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String   @db.VarChar(100)
  description String   @db.Text
  price       Int
  emoji       String   @db.VarChar(10) @default("🛍️")
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("products")
}

// ── Orders ────────────────────────────────────────────────────────────────────

enum OrderSource {
  TELEGRAM
  WEBSITE
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  orderId         String      @map("order_id") @db.VarChar(30)
  source          OrderSource @default(TELEGRAM)
  telegramId      BigInt?     @map("telegram_id")
  username        String?     @db.VarChar(100)
  firstName       String?     @map("first_name") @db.VarChar(100)
  customerName    String?     @map("customer_name") @db.VarChar(100)
  customerPhone   String?     @map("customer_phone") @db.VarChar(20)
  totalPrice      Int         @map("total_price")
  status          OrderStatus @default(PENDING)
  paymentUrl      String?     @map("payment_url") @db.Text
  qrString        String?     @map("qr_string") @db.Text
  midtransOrderId String?     @map("midtrans_order_id") @db.VarChar(50)
  paidAt          DateTime?   @map("paid_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  customerId  String?     @map("customer_id") @db.Uuid
  customer    Customer?   @relation(fields: [customerId], references: [id])

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  ticket     Ticket?

  @@unique([userId, orderId])
  @@unique([userId, midtransOrderId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Int     @map("unit_price")

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
  PAYMENT_PENDING
  PAYMENT_FAILED
}

// ── Customer Database ──────────────────────────────────────────────────────────

enum CustomerSource {
  ORDER
  MANUAL
  IMPORT
}

model Customer {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @map("user_id") @db.Uuid

  telegramId   BigInt?        @map("telegram_id")
  email        String?        @db.VarChar(255)
  phone        String?        @db.VarChar(20)

  name         String?        @db.VarChar(100)
  username     String?        @db.VarChar(100)
  notes        String?        @db.Text

  hasTelegram  Boolean        @default(false) @map("has_telegram")
  hasWhatsapp  Boolean        @default(false) @map("has_whatsapp")
  hasEmail     Boolean        @default(false) @map("has_email")

  firstOrderAt DateTime?      @map("first_order_at")
  lastOrderAt  DateTime?      @map("last_order_at")
  totalOrders  Int            @default(0) @map("total_orders")
  totalSpent   Int            @default(0) @map("total_spent")

  source       CustomerSource @default(ORDER)

  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([userId, telegramId])
  @@unique([userId, email])
  @@unique([userId, phone])
  @@index([userId, lastOrderAt])
  @@index([userId, totalSpent])
  @@index([userId, source])
  @@map("customers")
}

// ── Ticketing ─────────────────────────────────────────────────────────────────

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
  CANCELLED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketSource {
  ORDER
  MANUAL
}

model Ticket {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  orderId         String?       @unique @map("order_id") @db.Uuid
  title           String        @db.VarChar(255)
  description     String?       @db.Text
  status          TicketStatus  @default(OPEN)
  priority        TicketPriority @default(MEDIUM)
  source          TicketSource  @default(ORDER)
  customerName    String?       @map("customer_name") @db.VarChar(100)
  customerContact String?       @map("customer_contact") @db.VarChar(100)
  resolvedAt      DateTime?     @map("resolved_at")
  closedAt        DateTime?     @map("closed_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  order      Order?           @relation(fields: [orderId], references: [id])
  labels     TicketLabel[]
  comments   TicketComment[]
  activities TicketActivity[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("tickets")
}

model Label {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(50)
  color     String   @db.VarChar(7) @default("#3B82F6")
  createdAt DateTime @default(now()) @map("created_at")

  tickets TicketLabel[]
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("labels")
}

model TicketLabel {
  ticketId String @map("ticket_id") @db.Uuid
  labelId  String @map("label_id") @db.Uuid

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  label  Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([ticketId, labelId])
  @@map("ticket_labels")
}

model TicketComment {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  body       String   @db.Text
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([ticketId, createdAt])
  @@map("ticket_comments")
}

model TicketActivity {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(50)
  metadata  Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")

  ticket Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id])

  @@map("ticket_activities")
}
