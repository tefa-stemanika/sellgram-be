// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users ─────────────────────────────────────────────────────────────────────
// Tabel pemilik bot (tenant). Setiap user memiliki bot instance, config, dan data tersendiri.

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.Text
  name         String   @db.VarChar(100)
  plan         UserPlan @default(FREE)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relasi ke tabel lainnya
  botConfigs   BotConfig[]
  credentials  BotCredential[]
  products     Product[]
  orders       Order[]
  tickets      Ticket[]
  labels       Label[]
  comments     TicketComment[]
  activities   TicketActivity[]
  customers    Customer[]
  stockLogs              StockLog[]
  ticketFulfillmentLogs  TicketFulfillmentLog[]
  fulfillmentConfigs     FulfillmentConfig[]
  stockItems             StockItem[]
  slotAccounts           SlotAccount[]
  slots                  Slot[]
  fulfillmentLogs        FulfillmentLog[]

  @@map("users")
}

enum UserPlan {
  FREE
  STARTER
  PRO
}

// ── Bot Config ────────────────────────────────────────────────────────────────
// Menyimpan konfigurasi umum bot yang tidak sensitif.
// Setiap user memiliki BotConfig sendiri (user_id FK).

model BotConfig {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  mode             BotMode  @default(BUTTON)
  // Midtrans
  midtransIsProduction Boolean @default(false) @map("midtrans_is_production")
  // Meta
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, isActive])
  @@map("bot_config")
}

enum BotMode {
  AI
  BUTTON
}

// ── Bot Credentials ───────────────────────────────────────────────────────────
// Menyimpan credentials sensitif — nilai disimpan TERENKRIPSI (AES-256-GCM).
// Setiap user memiliki credentials sendiri (user_id FK).

model BotCredential {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  key       String   @db.VarChar(100)
  value     String?  @db.Text     // AES-256-GCM encrypted: "iv:authTag:ciphertext" (nullable)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("bot_credentials")
}

// ── Products ──────────────────────────────────────────────────────────────────

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String   @db.VarChar(100)
  description String   @db.Text
  price       Int
  emoji       String   @db.VarChar(10) @default("🛍️")
  isAvailable Boolean  @default(true) @map("is_available")

  stock        Int      @default(0)
  stockEnabled Boolean  @default(false) @map("stock_enabled")
  allowOversell Boolean @default(false) @map("allow_oversell")
  lowStockAlert Int     @default(5) @map("low_stock_alert")

  deletedAt   DateTime? @map("deleted_at")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  stockLogs  StockLog[]

  fulfillmentConfig FulfillmentConfig?
  stockItems        StockItem[]
  slotAccounts      SlotAccount[]
  slots             Slot[]

  @@map("products")
}

// ── Orders ────────────────────────────────────────────────────────────────────

enum OrderSource {
  TELEGRAM
  WEBSITE
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  orderId         String      @map("order_id") @db.VarChar(30)
  source          OrderSource @default(TELEGRAM)
  telegramId      BigInt?     @map("telegram_id")
  username        String?     @db.VarChar(100)
  firstName       String?     @map("first_name") @db.VarChar(100)
  customerName    String?     @map("customer_name") @db.VarChar(100)
  customerPhone   String?     @map("customer_phone") @db.VarChar(20)
  totalPrice      Int         @map("total_price")
  status          OrderStatus @default(PENDING)
  paymentUrl      String?     @map("payment_url") @db.Text
  qrString        String?     @map("qr_string") @db.Text
  midtransOrderId String?     @map("midtrans_order_id") @db.VarChar(50)
  paidAt          DateTime?   @map("paid_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  customerId  String?     @map("customer_id") @db.Uuid
  customer    Customer?   @relation(fields: [customerId], references: [id])

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  ticket     Ticket?

  fulfillmentLog FulfillmentLog?
  stockItems     StockItem[]
  slots          Slot[]

  @@unique([userId, orderId])
  @@unique([userId, midtransOrderId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Int     @map("unit_price")

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
  PAYMENT_PENDING
  PAYMENT_FAILED
}

// ── Customer Database ──────────────────────────────────────────────────────────

enum CustomerSource {
  ORDER
  MANUAL
  IMPORT
}

model Customer {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @map("user_id") @db.Uuid

  telegramId   BigInt?        @map("telegram_id")
  email        String?        @db.VarChar(255)
  phone        String?        @db.VarChar(20)

  name         String?        @db.VarChar(100)
  username     String?        @db.VarChar(100)
  notes        String?        @db.Text

  hasTelegram  Boolean        @default(false) @map("has_telegram")
  hasWhatsapp  Boolean        @default(false) @map("has_whatsapp")
  hasEmail     Boolean        @default(false) @map("has_email")

  firstOrderAt DateTime?      @map("first_order_at")
  lastOrderAt  DateTime?      @map("last_order_at")
  totalOrders  Int            @default(0) @map("total_orders")
  totalSpent   Int            @default(0) @map("total_spent")

  source       CustomerSource @default(ORDER)

  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  auth   CustomerAuth?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([userId, telegramId])
  @@unique([userId, email])
  @@unique([userId, phone])
  @@index([userId, lastOrderAt])
  @@index([userId, totalSpent])
  @@index([userId, source])
  @@map("customers")
}

// ── Customer Auth (Portal Login) ──────────────────────────────────────────────────

model CustomerAuth {
  id              String    @id @default(uuid()) @db.Uuid
  customerId      String    @unique @map("customer_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  email           String    @db.VarChar(255)
  passwordHash    String    @map("password_hash") @db.Text
  isVerified      Boolean   @default(false) @map("is_verified")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
  @@map("customer_auth")
}

// ── Stock Management ──────────────────────────────────────────────────────────────

enum StockLogType {
  SALE
  REFUND
  RESTOCK
  ADJUSTMENT
}

model StockLog {
  id         String        @id @default(uuid()) @db.Uuid
  productId  String        @map("product_id") @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  orderId    String?       @map("order_id") @db.Uuid
  type       StockLogType
  delta      Int
  stockAfter Int           @map("stock_after")
  note       String?       @db.VarChar(255)
  createdAt  DateTime      @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@map("stock_logs")
}

// ── Ticketing ─────────────────────────────────────────────────────────────────

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
  CANCELLED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketSource {
  ORDER
  MANUAL
}

model Ticket {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  orderId         String?       @unique @map("order_id") @db.Uuid
  title           String        @db.VarChar(255)
  description     String?       @db.Text
  status          TicketStatus  @default(OPEN)
  priority        TicketPriority @default(MEDIUM)
  source          TicketSource  @default(ORDER)
  customerName    String?       @map("customer_name") @db.VarChar(100)
  customerContact String?       @map("customer_contact") @db.VarChar(100)
  resolvedAt      DateTime?     @map("resolved_at")
  closedAt        DateTime?     @map("closed_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  order      Order?           @relation(fields: [orderId], references: [id])
  labels     TicketLabel[]
  comments   TicketComment[]
  activities TicketActivity[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("tickets")
}

model Label {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(50)
  color     String   @db.VarChar(7) @default("#3B82F6")
  createdAt DateTime @default(now()) @map("created_at")

  tickets TicketLabel[]
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("labels")
}

model TicketLabel {
  ticketId String @map("ticket_id") @db.Uuid
  labelId  String @map("label_id") @db.Uuid

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  label  Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([ticketId, labelId])
  @@map("ticket_labels")
}

model TicketComment {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  body       String   @db.Text
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([ticketId, createdAt])
  @@map("ticket_comments")
}

model TicketActivity {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(50)
  metadata  Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")

  ticket Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id])

  @@map("ticket_activities")
}

// ── Ticket Fulfillment Log ─────────────────────────────────────────────────────

enum TicketFulfillmentOperation {
  TICKET_CREATED
  TICKET_ASSIGNED
  LABEL_APPLIED
  LABEL_REMOVED
  COMMENT_ADDED
  STATUS_CHANGED
  PRIORITY_CHANGED
  CUSTOMER_LINK
  ACTIVITY_NOTE
  PAYMENT_COMPLETED
}

model TicketFulfillmentLog {
  id           String                     @id @default(uuid()) @db.Uuid
  userId       String                     @map("user_id") @db.Uuid
  ticketId     String                     @map("ticket_id") @db.Uuid
  operation    TicketFulfillmentOperation
  description  String                     @db.Text
  metadata     Json?                      @db.JsonB
  performedById String?                   @map("performed_by_id") @db.Uuid
  createdAt    DateTime                   @default(now()) @map("created_at")

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([userId, operation])
  @@map("ticket_fulfillment_logs")
}

// ── Fulfillment Engine ─────────────────────────────────────────────────────────

enum FulfillmentType {
  STOCK_POOL
  SLOT_ASSIGN
  API_EXTERNAL
  MANUAL
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  SKIPPED
}

enum StockItemStatus {
  AVAILABLE
  USED
  RESERVED
  EXPIRED
}

enum SlotStatus {
  ACTIVE
  AVAILABLE
  EXPIRED
}

model FulfillmentConfig {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  productId String          @unique @map("product_id") @db.Uuid

  type FulfillmentType

  // MANUAL
  manualNote String? @map("manual_note") @db.Text

  // API_EXTERNAL
  apiUrl            String?  @map("api_url") @db.Text
  apiMethod         String?  @default("POST") @map("api_method") @db.VarChar(10)
  apiHeaders        Json?    @map("api_headers") @db.JsonB
  apiPayloadTemplate String? @map("api_payload_template") @db.Text
  apiCredentials    String?  @map("api_credentials") @db.Text
  apiSuccessPath    String?  @map("api_success_path") @db.VarChar(255)
  apiSuccessValue   String?  @map("api_success_value") @db.VarChar(255)
  apiResultPath     String?  @map("api_result_path") @db.VarChar(255)

  deliveryMessage String? @map("delivery_message") @db.Text

  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("fulfillment_config")
}

model StockItem {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  productId String          @map("product_id") @db.Uuid

  content  String          @db.Text
  status   StockItemStatus @default(AVAILABLE)
  usedAt   DateTime?       @map("used_at")
  orderId  String?         @map("order_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id])

  @@index([productId, status])
  @@index([userId])
  @@map("stock_items")
}

model SlotAccount {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid

  label       String  @db.VarChar(255)
  credentials String  @db.Text
  totalSlots  Int     @map("total_slots")
  usedSlots   Int     @default(0) @map("used_slots")
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  slots   Slot[]

  @@index([productId, isActive])
  @@index([userId])
  @@map("slot_accounts")
}

model Slot {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  slotAccountId String      @map("slot_account_id") @db.Uuid
  productId     String      @map("product_id") @db.Uuid

  slotIdentifier String    @map("slot_identifier") @db.VarChar(255)
  additionalInfo String?   @map("additional_info") @db.Text
  status         SlotStatus @default(AVAILABLE)
  expiresAt      DateTime?  @map("expires_at")
  assignedAt     DateTime?  @map("assigned_at")
  orderId        String?    @map("order_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  slotAccount SlotAccount @relation(fields: [slotAccountId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  order       Order?      @relation(fields: [orderId], references: [id])
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([slotAccountId, status])
  @@index([productId, status])
  @@index([userId])
  @@map("slots")
}

model FulfillmentLog {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  orderId     String            @unique @map("order_id") @db.Uuid
  productId   String            @map("product_id") @db.Uuid

  type        FulfillmentType
  status      FulfillmentStatus @default(PENDING)

  attempts    Int    @default(0)
  maxAttempts Int    @default(3) @map("max_attempts")

  deliveredContent String?   @map("delivered_content") @db.Text
  deliveredAt      DateTime? @map("delivered_at")
  lastError        String?   @map("last_error") @db.Text
  lastAttemptAt    DateTime? @map("last_attempt_at")
  metadata         Json?     @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("fulfillment_logs")
}
