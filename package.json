{
  "name": "telegram-ai-bot",
  "version": "1.0.0",
  "description": "Telegram bot powered by Gemini AI dengan database PostgreSQL",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:push": "npx prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:seed-config": "node prisma/seed-config.js",
    "db:seed-migration-m6": "node prisma/seed-migration-m6.js",
    "db:studio": "npx prisma studio",
    "db:generate": "npx prisma generate",
    "test:integration": "node tests/integration-tests.js",
    "test:webhook": "node tests/webhook-tests.js",
    "test:load": "node tests/load-tests.js",
    "test:fulfillment": "node tests/fulfillment-tests.js",
    "test:bot-health": "node tests/bot-health-tests.js",
    "test:phase5": "npm run test:integration && npm run test:webhook && npm run test:load"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@openrouter/sdk": "^0.12.79",
    "@prisma/client": "^5.14.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.78.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "node-telegram-bot-api": "^0.66.0"
  },
  "devDependencies": {
    "prisma": "^5.14.0"
  }
}
