# =============================================
#  TELEGRAM AI BOT — Environment Variables
# =============================================
# Setelah menjalankan npm run db:seed-config,
# bagian CREDENTIALS di bawah sudah TIDAK DIPERLUKAN lagi
# (sudah tersimpan terenkripsi di database).
# Yang wajib tetap ada: DATABASE_URL, ENCRYPTION_KEY,
# JWT_SECRET, PORT, REDIS_URL, WEBHOOK_SECRET.

# =============================================
#  INFRASTRUKTUR (tetap di .env)
# =============================================
DATABASE_URL=postgresql://postgres:my_password@localhost:5284/db_telegram_bot?schema=public
PORT=3000
REDIS_URL=redis://localhost:6379
WEBHOOK_SECRET=your_telegram_webhook_secret
MIDTRANS_FINISH_URL=https://t.me/NgulikTelegram2Bot

# Kunci enkripsi untuk credentials di database
# Generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JANGAN pernah ubah setelah credentials tersimpan — data akan tidak bisa didekripsi
ENCRYPTION_KEY=your_64_char_hex_key_here
JWT_SECRET=your_long_random_jwt_secret

# =============================================
#  CREDENTIALS (dipindah ke DB via seed-config)
# =============================================
# Isi dulu sebelum menjalankan npm run db:seed-config.
# Setelah seed berhasil, baris-baris ini bisa dihapus.

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
ADMIN_BOT_TOKEN=your_admin_bot_token
ADMIN_CHAT_ID=your_admin_chat_id
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
AI_ENABLED=false
MIDTRANS_SERVER_KEY_SANDBOX=SB-Mid-server-xxxxxxxx
MIDTRANS_CLIENT_KEY_SANDBOX=SB-Mid-client-xxxxxxxx
MIDTRANS_SERVER_KEY_PRODUCTION=MID-Mid-server-xxxxxxxx
MIDTRANS_CLIENT_KEY_PRODUCTION=MID-Mid-client-xxxxxxxx
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
