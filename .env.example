# =============================================
#  TELEGRAM AI BOT — Environment Variables
# =============================================

# Telegram Bot Token (dari @BotFather)
TELEGRAM_BOT_TOKEN=...:...

ADMIN_BOT_TOKEN=...:...
ADMIN_CHAT_ID=...

# Google Gemini API Key (dari Google AI Studio)
GEMINI_API_KEY=...

# Model Gemini yang digunakan
# Pilihan: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
GEMINI_MODEL=gemini-flash-latest

# Mode polling atau webhook
# Gunakan "polling" untuk development lokal
# Gunakan "webhook" untuk production (VPS/server)
BOT_MODE=polling

# (Opsional) Untuk mode webhook - URL publik server kamu
# WEBHOOK_URL=https://yourdomain.com/webhook

# (Opsional) Port untuk server webhook
# PORT=3000

# =============================================
#  FUTURE: Payment Gateway (Midtrans)
# =============================================
MIDTRANS_SERVER_KEY=SB-Mid-server-...
MIDTRANS_CLIENT_KEY=SB-Mid-client-...
MIDTRANS_IS_PRODUCTION=false
WEBHOOK_PORT=3000

DATABASE_URL=mysql://root:my_password@localhost:3307/telegram_bot